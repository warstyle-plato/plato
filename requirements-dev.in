# Вход для requirements-dev.txt (точные версии с контрольными суммами);
# как пересобирать — в шапке requirements.in.
# Что нужно только тестам. В requirements.txt этому места нет: в образ, который
# крутится на проде, тестовые зависимости не возят.
#
# httpx2 здесь потому, что окружения разъехались молча. Локально стоит старая
# starlette — она берёт httpx и лишь предупреждает; на чистой машине ставится
# свежая, и она уже требует httpx2. Первый же прогон в CI умер на сборе тестов,
# не дойдя до кода: тринадцать файлов не импортировались. Незакреплённая
# зависимость — это зависимость, которая совпадает случайно.
# Приложение — отсюда же. Привязки к requirements.txt (-c) нет намеренно:
# pycel требует networkx<2.7, а pymupdf на проде получает networkx 3.x, и
# такая привязка не собирается. Расхождение одно; общие пакеты сверяет
# tests/test_requirements_are_pinned.py.
-r requirements.in
pytest>=9.2.0
# Свой срок у каждого теста. Без него зависший тест молча съедает долю до
# `timeout-minutes` раннера, и отмена не называет, кто висел. Метки
# `@pytest.mark.timeout(...)` в тестах без плагина ничего не делают.
pytest-timeout==2.4.0
httpx2>=0.28
# Вычислитель формул Excel: книга нежилого проекта сверяет свои живые формулы с
# движком, и проверка должна их считать без Excel (tests/test_nonres_workbook.py).
pycel==1.0b30
