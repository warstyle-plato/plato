# Тестовый стенд открывается браузером по IP: слушаем все интерфейсы.
# За nginx поставьте APP_BIND=127.0.0.1.
APP_BIND=0.0.0.0
APP_PORT=8080

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Адрес вебхука — там, где живёт бот. Обычно подставляется сам из RENDER_EXTERNAL_URL.
# TELEGRAM_PUBLIC_BASE_URL=https://plato-development-investment-model.onrender.com
# Куда ведёт кнопка «Открыть модель». Задавайте, когда бот и модель развёрнуты
# по разным адресам: вебхук должен остаться на боте, а мини-приложение —
# уехать на ядро, иначе в модели не заработают ни адреса, ни Подмосковье.
# TELEGRAM_WEB_APP_BASE_URL=https://developaid.ru
# На хосте с моделью нужен ТОТ ЖЕ токен бота: им подписана сессия
# мини-приложения, и без него оно отвечает «Telegram-сессия недействительна».
# Но вебхук у бота один, поэтому регистрацию здесь надо выключить, иначе этот
# сервер уведёт обновления с хоста, где живёт бот.
# TELEGRAM_WEBHOOK_ENABLED=0

# Ядро расчёта Подмосковья.
# Пусто — считать на месте: так работает сам сервер, где доступен НСПД.
# На Render, откуда до nspd.gov.ru не достучаться, задайте адрес ядра:
#   MO_CALC_API_URL=https://developaid.ru/mo/calculate
# Тихого отката на локальный расчёт нет: недоступное ядро — это ошибка,
# а не повод показать ТЭП, посчитанные без данных ЕГРН.
MO_CALC_API_URL=
# MO_CALC_TIMEOUT_SECONDS=180

# Платон (агент).
# Ключ нужен только там, где выполняется обращение к OpenAI. Если этот сервер
# до OpenAI не достаёт, оставьте ключ пустым и задайте адрес сервиса, который
# достаёт: интерфейс Платона Сергеевича остаётся здесь, наружу уходит только
# сам вызов модели. Браузер обращается по-прежнему к этому серверу, поэтому
# ни CORS, ни адреса внутреннего сервиса наружу не появляется.
OPENAI_API_KEY=
# PLATO_AI_URL=https://<сервис>/internal/plato/chat
# Общий секрет двух серверов, уходит в заголовке X-Plato-Secret.
# Задаётся с обеих сторон одинаковым значением.
PLATO_AI_PROXY_SECRET=
# PLATO_AI_TIMEOUT_SECONDS=120

# Геокодеры для поиска участка по адресу.
# DaData — единственный, кто отдаёт кадастровый номер напрямую.
YANDEX_GEOCODER_API_KEY=
DADATA_API_KEY=
# LAND_LOOKUP_GEOCODER=yandex

# НСПД
# NSPD_BASE_URL=https://nspd.gov.ru
# NSPD_TIMEOUT_SECONDS=25
# Повтор без проверки сертификата, если цепочка не проверилась.
# Поставьте 0, когда в образ добавлен корневой сертификат Минцифры.
NSPD_TLS_FALLBACK=1
