# Тестовый стенд открывается браузером по IP: слушаем все интерфейсы.
# За nginx поставьте APP_BIND=127.0.0.1.
APP_BIND=0.0.0.0
APP_PORT=8080

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Платон (агент)
OPENAI_API_KEY=

# Геокодеры для поиска участка по адресу.
# DaData — единственный, кто отдаёт кадастровый номер напрямую.
YANDEX_GEOCODER_API_KEY=
DADATA_API_KEY=
# LAND_LOOKUP_GEOCODER=yandex

# НСПД
# NSPD_BASE_URL=https://nspd.gov.ru
# NSPD_TIMEOUT_SECONDS=25
# Повтор без проверки сертификата, если цепочка не проверилась.
# Поставьте 0, когда в образ добавлен корневой сертификат Минцифры.
NSPD_TLS_FALLBACK=1
