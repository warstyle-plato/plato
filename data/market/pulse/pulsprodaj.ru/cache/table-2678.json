rice_max":null,"start_sale_month":"2020-11-01","start_sale_month_max":"2024-08-01","sale_start_news_date":"2020-10-07","sale_start_news_date_max":"2024-08-01","first_ddu_date":"2020-11-01","first_ddu_date_max":"2024-08-01","start_sale_date":null,"start_sale_date_max":null,"discount":{"Яндекс":["Рассрочка с ПВ от 20%; Первый взнос от 20%. Срок от 3 до 18 мес. Рассрочка предоставляется ПАО ПИК СЗ. Срок действия акции до 31.10.2026 г.","Ипотека от 16.9%; Ипотечный кредит предоставляет АО «ТБанк», лицензия ЦБ РФ №2673 от 09.07.2024. Полная стоимость кредита от 16.939% до 24.948% годовых, ставка от 16.9% до 22.7% годовых (ставка 16.9% годовых применяется при наличии личного страхования и страхования имущества), срок кредита от 1 года до 30 лет, первоначальный взнос от 20% от стоимости недвижимости, сумма кредита от 500000 руб. до 100000000 руб., цель кредита — приобретение квартиры по договору участия в долевом строительстве. Предложение носит информационный характер и не является публичной офертой. Срок действия акции до 31.10.2026 г.","Ипотека 12.39% на весь срок; Ипотеку предоставляет АО «Альфа-Банк», ген. лицензия ЦБ РФ №1326 от 16.01.2015. Полная стоимость кредита составляет от 12.470% до 23.258%, ставка 12.39% на весь срок, первоначальный взнос от 20.1%, срок кредита от 11 до 15 лет. Программа действует при покупке квартиры у партнёра АО «Альфа-Банк» при сумме кредита от 600000 руб. до 50000000 руб., при наличии личного страхования заемщика. Срок действия акции до 31.10.2026 г.","Ипотека от 8.99%; Кредит предоставляется ПАО «Совкомбанк» (генеральная лицензия Банка России № 963 от 05 декабря 2014 г.). При выдаче кредита на указанных условиях размер полной стоимости кредита от 14.529% до 19.512%. Ставка 8.99% устанавливается со дня заключения кредитного договора и применяется в течение 11 мес. при кредитовании по программе «Новостройка» и при условии заключения договоров страхования (после оформления права собственности) и присоединении заемщика с его согласия к: акции «Поэтапное повышение ставки» — процентная ставка повышается в несколько этапов, но не выше процентной ставки, установленной стандартами программы на дату заключения кредитного договора; программе «Субсидирование ипотеки». Ставка в первые 11 мес. — от 8.99%. Ставка с 12 мес. — от 11.99%. Ставка с 24 мес. — от 15.49%. Ставка с 36 мес. — от 19.49%. Первоначальный взнос от 30.01%. Срок — до 15 лет. Сумма кредита — до 50000000 руб. Кредит предоставляется на приобретение квартир и апартаментов в аккредитованных Банком объектах строительства у ГК ПИК. Срок действия акции до 31.10.2026 г.","Квартиры с выгодой до 2 000 000 руб.; Квартиры с выгодой до 2000000 руб. Количество предложений ограничено. Срок действия акции до 31.10.2026 г."],"Циан":["Ипотека 12,39% на весь срок (до 31.10.26) - полная стоимость кредита: 12,5–23,3%, ставка: 12,39%, срок кредита: до 15 лет, сумма кредита: до 50 млн ₽, первый взнос: от 20%; Лёгкий старт от 8,99% (до 31.10.26) - полная стоимость кредита: 14,5–19,5%, ставка: 8,99%, срок кредита: до 15 лет, сумма кредита: до 50 млн ₽, первый взнос: от 30%; Гибкая рассрочка. ПВ от 20%  (до 31.10.26) - первый взнос: от 20%"]},"has_escrow":true,"escrow":[["Сбербанк",10]],"sources":[{"grabber_id":36818,"domain":"pik.ru","url":"https://pik.ru","main":true,"primary":true,"price_date":"2026-10-25T12:00:00","selected_as_main":true},{"grabber_id":13884,"domain":"domclick.ru","url":"https://domclick.ru","main":false,"primary":false,"price_date":"2026-10-25T12:00:00"},{"grabber_id":9501,"domain":"zhk-kronshtadtskiy-9-i.cian.ru","url":"https://zhk-kronshtadtskiy-9-i.cian.ru/","main":false,"primary":false,"price_date":"2026-10-21T12:00:00"},{"grabber_id":9516,"domain":"realty.ya.ru","url":"https://realty.ya.ru","main":false,"primary":false,"price_date":"2026-10-20T12:00:00"}],"rns":[{"rns_num":"77-124000-019125-2020","from_date":"2020-09-16","buildings_count":1,"buildings_nums":"2"},{"rns_num":"77-124000-019254-2020","from_date":"2020-11-24","buildings_count":6,"b